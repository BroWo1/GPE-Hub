{
  "name": "gpehub",
  "version": "1.2.2",
  "description": "GPEHub",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "repository": "https://github.com/BroWo1/GPE-Hub",
  "keywords": [
    "GPEHub",
    "GPE Club",
    "AI",
    "Game Programming Engineering",
    "GPE"
  ],
  "author": "Will",
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "@material/web": "^2.2.0",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "node-fetch": "^3.3.2",
    "openai": "^4.85.1"
  },
  "build": {
    "appId": "com.gpeclub.gpehub",
    "productName": "GPEHub",
    "files": [
      "main.js",
      "static/**/*",
      "node_modules/**/*",
      "package.json",
      "views/**/*",
      "MathJax/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "icon": "static/imgs/logo.icns",
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "static/imgs/logo.ico",
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
